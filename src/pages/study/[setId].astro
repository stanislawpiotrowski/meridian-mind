---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { createClient } from "@/lib/supabase";
import { ensureOpenSession } from "@/lib/studySession";
import { boundingBox, DEFAULT_CORRECT_THRESHOLD_KM } from "@/lib/study";
import { prioritizeQueue, type LastAttempt } from "@/lib/prioritize";
import StudySession, { type StudyFlashcard, type PriorAttempt } from "@/components/study/StudySession";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/auth/signin");

const setId = Astro.params.setId;
if (!setId) return Astro.redirect("/sets");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/sets");

// Load the set (RLS scopes to the owner; a foreign/missing set yields no row).
const { data: set } = await supabase.from("sets").select("id, name").eq("id", setId).maybeSingle();
if (!set) return Astro.redirect("/sets");

// Flashcards in stable insertion order — this IS the queue (FR-008).
const { data: flashcardRows } = await supabase
  .from("flashcards")
  .select("id, name, latitude, longitude")
  .eq("set_id", setId)
  .order("created_at", { ascending: true });

const flashcards: StudyFlashcard[] = flashcardRows ?? [];

// Defensive 0-card handling: show a message, create no session.
const hasCards = flashcards.length > 0;

let sessionId: string | null = null;
let priorAttempts: PriorAttempt[] = [];
// The queue passed to the island — reordered by priority once we have history.
let queue: StudyFlashcard[] = flashcards;

if (hasCards) {
  sessionId = await ensureOpenSession(supabase, user.id, setId);

  if (sessionId) {
    const { data: history } = await supabase
      .from("study_history")
      .select("flashcard_id, distance_km")
      .eq("session_id", sessionId);

    priorAttempts = (history ?? []).map((h) => ({ flashcardId: h.flashcard_id, distanceKm: h.distance_km }));

    // Prior-session attempts (excluding the current open session, so the order
    // stays stable as the student answers within it). Newest-first, keeping the
    // first row per flashcard = its most recent attempt (FR-016).
    const { data: priorHistory } = await supabase
      .from("study_history")
      .select("flashcard_id, distance_km, created_at")
      .eq("user_id", user.id)
      .eq("set_id", setId)
      .neq("session_id", sessionId)
      .order("created_at", { ascending: false });

    const lastAttempts = new Map<string, LastAttempt>();
    for (const row of priorHistory ?? []) {
      if (!lastAttempts.has(row.flashcard_id)) {
        lastAttempts.set(row.flashcard_id, { distanceKm: row.distance_km, lastSeenAt: row.created_at });
      }
    }

    queue = prioritizeQueue(flashcards, lastAttempts, new Date());
  }
}

const bbox = boundingBox(flashcards.map((f) => ({ lat: f.latitude, lng: f.longitude })));
---

<AuthLayout title={`Study — ${set.name}`}>
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      {set.name}
    </h1>

    {
      !hasCards ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
          <p class="text-blue-100/70">This set has no cards yet, so there's nothing to study.</p>
          <a href="/sets" class="mt-4 inline-block text-purple-200 underline-offset-4 hover:underline">
            Back to sets
          </a>
        </div>
      ) : sessionId ? (
        <StudySession
          client:load
          sessionId={sessionId}
          setId={setId}
          flashcards={queue}
          priorAttempts={priorAttempts}
          bbox={bbox}
          thresholdKm={DEFAULT_CORRECT_THRESHOLD_KM}
        />
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
          <p class="text-blue-100/70">Couldn't start a study session. Please try again.</p>
          <a href="/sets" class="mt-4 inline-block text-purple-200 underline-offset-4 hover:underline">
            Back to sets
          </a>
        </div>
      )
    }
  </div>
</AuthLayout>
