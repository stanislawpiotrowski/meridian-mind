---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { createClient } from "@/lib/supabase";
import { getDashboardData, type DashboardData } from "@/lib/dashboard";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/auth/signin");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let data: DashboardData;
if (supabase) {
  data = await getDashboardData(supabase, user.id);
} else {
  // No configured client — treat as a load failure, never as "no sets".
  data = { sets: [], streak: 0, resume: null, isEmpty: false, loadError: true };
}
---

<AuthLayout title="Dashboard">
  <div class="mx-auto max-w-2xl">
    <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
      Dashboard
    </h1>

    {
      data.loadError ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
          <p class="text-blue-100/70">Couldn't load your dashboard — try refreshing.</p>
        </div>
      ) : data.isEmpty ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
          <h2 class="mb-2 text-lg font-semibold">Welcome to MeridianMind 👋</h2>
          <p class="mb-6 text-sm text-blue-100/80">
            Get started by adding a ready-made set or importing your own — then come back here to study.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href="/sets"
              class="flex-1 rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-center font-medium text-white transition-colors hover:bg-white/20"
            >
              Add a ready-made set
            </a>
            <a
              href="/sets"
              class="flex-1 rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-center font-medium text-white transition-colors hover:bg-white/20"
            >
              Import your own CSV
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-6">
          {data.resume && (
            <a
              href={`/study/${data.resume.setId}`}
              class="block rounded-2xl border border-white/10 bg-gradient-to-r from-blue-500/30 to-purple-500/30 p-6 text-center text-lg font-semibold text-white backdrop-blur-xl transition-colors hover:from-blue-500/40 hover:to-purple-500/40"
            >
              {data.resume.isResume ? "Resume session" : "Start studying"}
            </a>
          )}

          <div class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
            {data.streak > 0 ? (
              <p class="text-center font-medium">🔥 {data.streak}-day streak</p>
            ) : (
              <p class="text-center text-sm text-blue-100/70">Study today to start a streak 🔥</p>
            )}
          </div>

          <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl">
            <ul class="divide-y divide-white/10">
              {data.sets.map((set) => (
                <li>
                  <a
                    href={`/study/${set.id}`}
                    class="flex items-center justify-between px-6 py-4 text-white transition-colors hover:bg-white/5"
                  >
                    <div>
                      <p class="font-medium">{set.name}</p>
                      <p class="mt-0.5 text-sm text-blue-100/50">{set.cardCount} cards</p>
                    </div>
                    {set.dueCount > 0 ? (
                      <span class="ml-4 shrink-0 rounded-full bg-purple-500/30 px-3 py-1 text-sm font-medium text-purple-100">
                        {set.dueCount} to review
                      </span>
                    ) : (
                      <span class="ml-4 shrink-0 text-sm text-blue-100/40">All caught up</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </div>
</AuthLayout>
