---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/auth/signin");

interface SetWithCount {
  id: string;
  name: string;
  created_at: string;
  flashcards: { count: number }[];
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let sets: SetWithCount[] = [];

if (supabase) {
  const { data } = await supabase
    .from("sets")
    .select("id, name, created_at, flashcards(count)")
    .eq("user_id", user.id)
    .order("created_at", { ascending: false })
    .overrideTypes<SetWithCount[], { merge: false }>();

  sets = data ?? [];
}
---

<Layout title="My Sets">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />

      <div class="mx-auto max-w-2xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          My Sets
        </h1>

        {/* Phase 3: import island mounts here */}
        <div id="import-form-slot" class="mb-8"></div>

        {
          sets.length === 0 ? (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
              <p class="text-blue-100/70">No sets yet. Import a CSV above to get started.</p>
            </div>
          ) : (
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl">
              <ul class="divide-y divide-white/10">
                {sets.map((set) => (
                  <li>
                    <a
                      href={`/study/${set.id}`}
                      class="flex items-center justify-between px-6 py-4 text-white transition-colors hover:bg-white/5"
                    >
                      <div>
                        <p class="font-medium">{set.name}</p>
                        <p class="mt-0.5 text-sm text-blue-100/50">{new Date(set.created_at).toLocaleDateString()}</p>
                      </div>
                      <span class="ml-4 shrink-0 text-sm text-blue-100/60">{set.flashcards[0]?.count ?? 0} cards</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
