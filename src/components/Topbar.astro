---
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

const linkBase = "transition-colors hover:text-purple-100 hover:underline";
const linkClass = (href: string) =>
  pathname === href ? `text-purple-100 underline ${linkBase}` : `text-purple-300 ${linkBase}`;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <div class="flex items-center gap-3">
          <a href="/sets" class="font-semibold text-white transition-colors hover:text-purple-100">
            MeridianMind
          </a>
          <span class="text-blue-100/70">{user.email}</span>
        </div>
        <div class="flex items-center gap-3">
          <a href="/sets" class:list={[linkClass("/sets")]} aria-current={pathname === "/sets" ? "page" : undefined}>
            My sets
          </a>
          <a
            href="/dashboard"
            class:list={[linkClass("/dashboard")]}
            aria-current={pathname === "/dashboard" ? "page" : undefined}
          >
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={[`text-purple-300 ${linkBase}`]}>
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
